# DocMind-AI configuration template.
# Copy this file to `.env` (or export the variables) and fill in real values.
# Do NOT commit your real `.env` — it contains secrets.

# --- Persistence -----------------------------------------------------------
# "json" (default, no database required) or "postgres".
PERSISTENCE_BACKEND=json

# PostgreSQL connection URL. REQUIRED when PERSISTENCE_BACKEND=postgres.
# DATABASE_URL=postgresql+psycopg://dbuser:dbpassword@localhost:5432/docmind

# --- Authentication --------------------------------------------------------
# REQUIRED. A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# JWT token settings.
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- Storage paths (all optional; defaults anchor to backend/storage) ------
# STORAGE_DIR=storage
# FAISS_INDEX_PATH=storage/faiss/index.faiss
# METADATA_PATH=storage/metadata.json
# DOCUMENTS_PATH=storage/documents.json
# USERS_PATH=storage/users.json
# LOGS_DIR=storage/logs

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Document chunking -----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Maximum allowed size in bytes for an uploaded document (default 50 MiB).
MAX_UPLOAD_SIZE_BYTES=52428800

# --- LLM providers ---------------------------------------------------------
# Optional: select a single provider. If unset, PROVIDER_PRIORITY is used.
# LLM_PROVIDER=openrouter
PROVIDER_PRIORITY=openrouter,gemini,groq

DEFAULT_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.0
MAX_TOKENS=1000
TIMEOUT=60

# Provider API keys — set at least one matching key. Placeholders only.
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
# GITHUB_API_KEY=ghp_REPLACE_WITH_YOUR_GITHUB_KEY
# CEREBRAS_API_KEY=REPLACE_WITH_YOUR_CEREBRAS_KEY
# SAMBANOVA_API_KEY=REPLACE_WITH_YOUR_SAMBANOVA_KEY
