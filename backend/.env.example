# DocMind-AI configuration template.
# Copy this file to `.env` (or export the variables) and fill in real values.
# Do NOT commit your real `.env` — it contains secrets.

# --- Persistence -----------------------------------------------------------
# "json" (default, no database required) or "postgres".
PERSISTENCE_BACKEND=json

# PostgreSQL connection URL. REQUIRED when PERSISTENCE_BACKEND=postgres.
# DATABASE_URL=postgresql+psycopg://dbuser:dbpassword@localhost:5432/docmind

# --- Authentication --------------------------------------------------------
# REQUIRED. A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# JWT token settings.
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- CORS ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Empty
# disallows all cross-origin browser requests (same-origin still works).
# Defaults below match the local Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting -------------------------------------------------------
# Lightweight in-memory fixed-window limits per client IP (per minute).
# Set RATE_LIMIT_ENABLED=false to disable. State resets on restart; not
# shared across processes (no Redis).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=60
# Trust X-Forwarded-For for the client IP when running behind a reverse proxy.
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# --- Storage paths (all optional; defaults anchor to backend/storage) ------
# STORAGE_DIR=storage
# FAISS_INDEX_PATH=storage/faiss/index.faiss
# METADATA_PATH=storage/metadata.json
# DOCUMENTS_PATH=storage/documents.json
# USERS_PATH=storage/users.json
# LOGS_DIR=storage/logs

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Document chunking -----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Maximum allowed size in bytes for an uploaded document (default 50 MiB).
MAX_UPLOAD_SIZE_BYTES=52428800

# --- LLM providers ---------------------------------------------------------
# Optional: select a single provider. If unset, PROVIDER_PRIORITY is used.
# LLM_PROVIDER=openrouter
PROVIDER_PRIORITY=openrouter,gemini,groq

DEFAULT_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=groq/compound-mini
TEMPERATURE=0.0
MAX_TOKENS=1000
TIMEOUT=60

# Provider API keys — set at least one matching key. Placeholders only.
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
# GITHUB_API_KEY=ghp_REPLACE_WITH_YOUR_GITHUB_KEY
# CEREBRAS_API_KEY=REPLACE_WITH_YOUR_CEREBRAS_KEY
# SAMBANOVA_API_KEY=REPLACE_WITH_YOUR_SAMBANOVA_KEY
