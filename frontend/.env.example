# Base URL of the DocMind AI backend API (FastAPI).
# The dev server and production app send all API requests here.
# For local development with the Vite dev proxy, set this to an empty value so
# requests go to the Vite origin and are proxied to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=

# Backend origin the Vite dev server proxies API calls to. Only used when
# VITE_API_BASE_URL is empty (same-origin development mode).
# Copy this into .env.development to point at your local DocMind backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8011

# Optional: request timeout in milliseconds.
# VITE_API_TIMEOUT_MS=60000
